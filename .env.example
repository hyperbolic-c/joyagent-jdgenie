# Genie Tool 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ============================================
# LLM 配置（必填）
# ============================================

# LLM API 密钥
LLM_API_KEY=your-api-key-here

# LLM 基础 URL（默认使用 OpenAI）
# OpenAI: https://api.openai.com/v1
# Azure: https://your-resource.openai.azure.com/
# Claude: https://api.anthropic.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# NL2SQL 模型配置
NL2SQL_MODEL_NAME=gpt-4.1
REWRITE_MODEL_NAME=gpt-4.1
THINK_MODEL_NAME=gpt-4.1

# ============================================
# 可选：向量数据库配置（用于 TableRAG）
# ============================================

# Qdrant 配置
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Elasticsearch 配置
ES_HOST=localhost
ES_PORT=9200

# ============================================
# 可选：其他模型配置
# ============================================

# Table Filter 模型
TR_TABLE_FILTER_MODEL_NAME=gpt-4.1
TR_COLUMN_FILTER_MODEL_NAME=gpt-4.1

# Cal Engine 模型
CAL_ENGINE_MODEL=gpt-4.1

# ============================================
# 可选：文件服务器配置
# ============================================

FILE_SERVER_URL=http://localhost:8080

# ============================================
# 可选：日志配置
# ============================================

LOG_PATH=./logs/server.log
